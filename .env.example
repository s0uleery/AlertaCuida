# Plantilla de las credenciales locales. Copiar como .env (no se sube al repositorio):
#   Windows (PowerShell): Copy-Item .env.example .env
#   Mac o Linux:          cp .env.example .env
# La usan docker-compose.yml y el backend con el perfil dev. Son solo para desarrollo.
DB_NOMBRE=alertacuida
DB_USUARIO=alertacuida
DB_CLAVE=cambiar-esta-clave
# Cambiar si el 5432 ya está ocupado en este computador
DB_PUERTO=5432
# Puertos de los contenedores del backend y del dashboard. Cambiar si ya están ocupados
BACK_PUERTO=8080
FRONT_PUERTO=5173
# Bandeja de Mailpit, donde se ven los correos de prueba del backend. Cambiar si el 8025 ya está ocupado
MAIL_PUERTO=8025
# Avisos al reloj: SIMULADO los anota en el log; SIMULADOR se los entrega al simulador de reloj (simulador-reloj/)
FCM_CANAL=SIMULADO
# Puerto donde escucha el simulador de reloj. Cambiar si el 9090 ya está ocupado
SIM_PUERTO=9090
# WhatsApp: NO_CONFIGURADO (todo sale por correo de respaldo) o SIMULADOR (simulador-whatsapp/, ver su README).
# Con SIMULADOR, el secreto debe ser el mismo --secreto del simulador; los demás valores son de juguete.
WHATSAPP_CANAL=NO_CONFIGURADO
SIM_WHATSAPP_PUERTO=9091
WHATSAPP_TOKEN=token-del-simulador
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_APP_SECRET=secreto-del-simulador
WHATSAPP_VERIFY_TOKEN=verificacion-local
WHATSAPP_PLANTILLA_LEVE=alerta_leve
WHATSAPP_PLANTILLA_GRAVE=alerta_grave
WHATSAPP_PLANTILLA_SIMULACRO=simulacro
