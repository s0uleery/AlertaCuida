# Plantilla de las credenciales locales. Copiar como .env (no se sube al repositorio):
#   Windows (PowerShell): Copy-Item .env.example .env
#   Mac o Linux:          cp .env.example .env
# La usan docker-compose.yml y el backend con el perfil dev. Son solo para desarrollo.
DB_NOMBRE=alertacuida
DB_USUARIO=alertacuida
DB_CLAVE=cambiar-esta-clave
# Cambiar si el 5432 ya está ocupado en este computador
DB_PUERTO=5432
# Puertos de los contenedores del backend y del dashboard. Cambiar si ya están ocupados
BACK_PUERTO=8080
FRONT_PUERTO=5173
# Bandeja de Mailpit, donde se ven los correos de prueba del backend. Cambiar si el 8025 ya está ocupado
MAIL_PUERTO=8025
