# Plantilla del .env del SERVIDOR público (no del computador de desarrollo). En el servidor:
#   cp .env.servidor.example .env   y completar cada valor. El .env nunca se sube al repositorio.
# Guía completa: docs/despliegue.md.

# Con esto, "docker compose ..." usa el archivo del servidor sin escribir -f
COMPOSE_FILE=docker-compose.servidor.yml

# Dirección pública, sin https:// (debe apuntar a la IP del servidor)
DOMINIO=alertacuida.app

# Base de datos. DB_CLAVE: generar con  openssl rand -base64 24
DB_NOMBRE=alertacuida
DB_USUARIO=alertacuida
DB_CLAVE=

# Claves del backend. Generar cada una con el comando indicado y no repetirlas entre sí.
# RUN_CLAVE: openssl rand -base64 48   (si cambia, hay que recalcular el rut_hash de todos)
RUN_CLAVE=
# JWT_CLAVE: openssl rand -base64 48
JWT_CLAVE=
# CIFRADO_CLAVE: openssl rand -base64 32   (EXACTAMENTE este comando: son 32 bytes)
# Guardar una copia fuera del servidor: si se pierde, los datos personales cifrados no se recuperan.
CIFRADO_CLAVE=
# RESPUESTA_CLAVE: openssl rand -base64 48   (si cambia, los enlaces ya enviados dejan de servir)
RESPUESTA_CLAVE=

# Correo por Gmail. SMTP_CLAVE es una "contraseña de aplicación" de Google (16 letras, sin espacios),
# no la contraseña normal: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
SMTP_USUARIO=
SMTP_CLAVE=

# Avisos al reloj: SIMULADO solo los anota en el log (hasta tener Firebase)
FCM_CANAL=SIMULADO

# Primer administrador: al arrancar, si no hay ninguno, se crea con estos datos y el enlace para elegir
# la contraseña queda en el log (docker compose logs backend | grep "Administrador inicial").
# Una vez creado, estos valores ya no hacen nada (se pueden dejar o borrar).
ADMIN_INICIAL_RUN=
ADMIN_INICIAL_NOMBRE=
ADMIN_INICIAL_CORREO=
