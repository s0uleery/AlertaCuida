<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Hereda las versiones de librerías y plugins de Spring Boot -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>cl.ucn.alertacuida</groupId>
	<artifactId>alertacuida-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>AlertaCuida</name>
	<description>Plataforma de teleasistencia PRLAC</description>

	<!-- Orden de dependencia: domain <- application <- adapters <- app -->
	<modules>
		<module>domain</module>
		<module>application</module>
		<module>adapters</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<!-- Versiones de los módulos propios, para no repetirlas en cada hijo -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>cl.ucn.alertacuida</groupId>
				<artifactId>alertacuida-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>cl.ucn.alertacuida</groupId>
				<artifactId>alertacuida-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>cl.ucn.alertacuida</groupId>
				<artifactId>alertacuida-adapters</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
